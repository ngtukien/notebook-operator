# Stage 1: Build Runner binary
FROM golang:1.27-alpine AS runner-builder
WORKDIR /app
COPY script/runner.go .
RUN CGO_ENABLED=0 GOOS=linux go build -o /runner runner.go

# Stage 2: Base Systemd Image
FROM ghcr.io/nestybox/ubuntu-focal-systemd:latest

# KubeClass Linux-lab Base Image 
ENV DEBIAN_FRONTEND=noninteractive

# Install core Linux utilities, Git tooling, Networking, and Development tools
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    # Git & SSH
    git git-lfs openssh-client ca-certificates \
    # Text Editors & Terminal UX
    vim nano less bash-completion tree tmux \
    # Core CLI Utilities
    curl wget unzip zip tar sudo jq rsync \
    # Networking & Diagnostics
    net-tools iproute2 iputils-ping dnsutils traceroute lsof telnet \
    # Monitoring & Development
    htop procps build-essential python3 python3-pip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy MOTD & Enable Git Bash Autocompletion
COPY motd /etc/motd
RUN echo "source /usr/share/bash-completion/completions/git" >> /etc/bash.bashrc && \
    echo "cat /etc/motd" >> /etc/bash.bashrc

# Copy Runner binary & systemd service
COPY --from=runner-builder /runner /usr/local/bin/runner
COPY script/runner.service /etc/systemd/system/runner.service
RUN mkdir -p /etc/systemd/system/multi-user.target.wants && \
    ln -s /etc/systemd/system/runner.service /etc/systemd/system/multi-user.target.wants/runner.service